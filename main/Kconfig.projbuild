    menu "Other"
        choice
            prompt "Switch Input Mode"
            default SWITCH_INPUT_MODE_TOGGLE
            help
                Select the switch input mode.

            config SWITCH_INPUT_MODE_TOGGLE
                bool "Toggle"

            config SWITCH_INPUT_MODE_PUSHBUTTON
                bool "Pushbutton"
        endchoice

        config GPIO_INDICATOR_LED
            int "GPIO Pin for Indicator LED"
            default 2
            range 0 39
            help
                The GPIO pin number for the onboard or external indicator LED. Default is 2.
    endmenu

endmenu