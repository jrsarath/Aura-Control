menu "Switch Configuration"

    menu "Switch 1"
        config SWITCH_1_INPUT_PIN
            int "GPIO Pin for Switch 1 input"
            default 4
            range 0 39
            help
                The GPIO pin number for the input of Switch 1. Default is 4.

        config SWITCH_1_OUTPUT_PIN
            int "GPIO Pin for Switch 1 output"
            default 12
            range 0 39
            help
                The GPIO pin number for the output of Switch 1. Default is 12.
    endmenu

